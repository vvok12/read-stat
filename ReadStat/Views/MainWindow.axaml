<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReadStat.ViewModels"
        xmlns:views="clr-namespace:ReadStat.Views"
        xmlns:books="clr-namespace:ReadStat.ViewModels.Books"
        x:Class="ReadStat.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ReadStat">

  <Design.DataContext>
    <vm:MainViewModel/>
  </Design.DataContext>
  
  <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*">
    <views:StatsView Grid.Column="0" Grid.ColumnSpan="2" />

    <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
      <ListBox
        DoubleTapped="InputElement_OnDoubleTapped"
        ItemsSource="{Binding Books}" 
        SelectedItem="{Binding Selected, Mode=TwoWay}"
        SelectionMode="Single" />
    </ScrollViewer>
  </Grid>
</Window>
