<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReadStat.ViewModels"
        xmlns:views="clr-namespace:ReadStat.Views"
        x:Class="ReadStat.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ReadStat">

  <Design.DataContext>
    <vm:MainViewModel/>
  </Design.DataContext>

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <Button Content="Add" Command="{Binding AddCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
      <Button Content="Edit" Command="{Binding EditCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
      <Button Content="Delete" Command="{Binding DeleteCommand}" />
      <Button Content="Refresh" Command="{Binding Refresh}" />
    </StackPanel>

    <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*">
      <views:StatsView Grid.Column="1" />

      <ScrollViewer Grid.Column="0" Grid.Row="1">
        <ListBox 
          ItemsSource="{Binding Books}" 
          SelectedItem="{Binding Selected, Mode=TwoWay}"
          SelectionMode="Single"/>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
